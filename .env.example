# ---- Required ----
OPENAI_API_KEY=sk-...
MANGOOLS_API_KEY=your-mangools-api-token
GOOGLE_SERVICE_ACCOUNT_EMAIL=kr-workbench@your-project.iam.gserviceaccount.com
# Paste the private_key from the service-account JSON. Keep the \n sequences as they are.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
MANAGER_PIN=choose-a-pin-for-the-manager
# The manager who approves keywords. Set this in Vercel: the approval step checks it.
MANAGER_EMAIL=hummer@kingsresearch.com

# ---- Sign-in ----
# Everyone signs in with their work email. The first time they use the starting password below and must then
# set their own. Accounts are kept in the "Users" sheet tab (delete a row to reset that person).
FIRST_PASSWORD=1234
# Only emails on this domain can sign in.
LOGIN_EMAIL_DOMAIN=kingsresearch.com
# A long random text that signs the sessions. Optional: without it a secret is derived from the keys above.
# Changing it signs everyone out.
AUTH_SECRET=

# ---- Cost savers (recommended: these cut the AI cost per report by about 90%) ----
# Jev answers yes/no and multiple-choice questions for a fraction of the chat-model price.
# Set ONE of these two keys: a TypeSafe key (console.typesafe.ai) or a Vercel AI Gateway key.
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
# Web search for the fact-check: Tavily gives 1,000 free searches every month (tavily.com, key starts with tvly-).
# If the key is missing or the month's free searches are used up, the tool checks each sentence against its own
# source link instead, so nothing is ever charged for search.
TAVILY_API_KEY=
# Optional backup search, tried only if Tavily fails (serper.dev: 2,500 free searches once, then paid packs).
SERPER_API_KEY=
# Fact-check engine. Leave empty for automatic: "lite" when a Jev key is set, otherwise "deep".
#   lite = web search (or the sentence's own link) judged by Jev        deep = OpenAI web search (1 to 3 cents a claim)
#   both = deep, with the lite verdict shown beside it (use this to compare the two before trusting lite)
FACT_ENGINE=
# How sure Jev must be (0 to 1) before a verdict stands on its own; below this the claim is marked "Check manually".
FACT_MIN_CONFIDENCE=0.8
# How long a checked fact is reused from the "Fact Cache" sheet tab before it is checked again.
FACT_CACHE_DAYS=180
# Who picks the facts to check, and who prioritises keyword topics: jev (default when a Jev key is set) or openai.
FACT_TRIAGE=jev
DECISION_ENGINE=jev
JEV_MODEL=jev-latest

# ---- Optional (defaults shown) ----
GOOGLE_SHEET_ID=1NDDgdv4DGNpO8aYzq9VTtyD10O0rfn2Foa0lNobUzjM
# If set, everyone must also enter this key once in the tool (Setup button).
TEAM_ACCESS_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_SEARCH_MODEL=gpt-4.1-mini
# Set to false to verify facts from model knowledge only (no web search) in the deep engine.
OPENAI_WEB_SEARCH=true
MANGOOLS_LANGUAGE_ID=0
COMPETITORS=marketresearchfuture.com,futuremarketinsights.com,marketsandmarkets.com,precedenceresearch.com,persistencemarketresearch.com
SITE_BASE=https://www.kingsresearch.com
APP_TIMEZONE=Asia/Kolkata
# Only if preview pages need a login: copy the Cookie header from a logged-in browser session.
KR_COOKIE=
